 <span id=\"greeting-name\">{{ name|safe }}</span>!</h2><p id=\"xss-marker\" class=\"muted\">Добро пожаловать в рабочее пространство.</p><a href=\"{{ url_for('employees') }}\">← К сотрудникам</a></section>{% endblock %}"},"startColumn":254,"startLine":1}}}],"message":{"text":"Template explicitly disables escaping; review the origin of the rendered value."},"properties":{},"ruleId":"sast.lab-jinja-autoescape-bypass"},{"fingerprints":{"matchBasedId/v1":"requires login"},"locations":[{"physicalLocation":{"artifactLocation":{"uri":"app/templates/ticket.html","uriBaseId":"%SRCROOT%"},"region":{"endColumn":846,"endLine":1,"snippet":{"text":"{% extends 'base.html' %}{% block content %}<a class=\"back-link\" href=\"{{ url_for('tickets') }}\">← Мои заявки</a><div class=\"page-heading\"><div><p class=\"eyebrow\">ЗАЯВКА #{{ ticket.id }}</p><h1>{{ ticket.title }}</h1><p class=\"muted\">{{ ticket.owner }} · {{ ticket.created_at }}</p></div><span class=\"pill blue\">{{ ticket.status }}</span></div><div class=\"detail-grid\"><div><section class=\"card padded\"><h2>Описание</h2><p class=\"preserve\">{{ ticket.body }}</p></section><section class=\"card padded comments\"><h2>Обсуждение <span class=\"count\">{{ comments|length }}</span></h2>{% for comment in comments %}<article class=\"comment\"><span class=\"avatar\">{{ comment.initials }}</span><div><strong>{{ comment.name }}</strong><small>{{ comment.created_at }}</small><div class=\"comment-body\">{{ comment.body|safe }}</div></div></article>{% endfor %}<form method=\"post\"><input type=\"hidden\" name=\"csrf_token\" value=\"{{ csrf_token() }}\"><label for=\"body\">Ваш комментарий</label><textarea name=\"body\" id=\"body\" rows=\"3\" maxlength=\"4000\" placeholder=\"Добавьте подробности или задайте вопрос\" required></textarea><button class=\"button\">Отправить комментарий</button></form></section></div><aside class=\"card padded details\"><h2>Детали заявки</h2><dl><dt>Категория</dt><dd>{{ ticket.category }}</dd><dt>Приоритет</dt><dd>{{ ticket.priority }}</dd><dt>Автор</dt><dd>{{ ticket.owner }}</dd><dt>Номер</dt><dd>#{{ ticket.id }}</dd></dl>{% if ticket.id == 1003 %}<p class=\"notice\">Совместная заявка Алисы и Бориса. Оба участника могут читать и писать комментарии.</p>{% endif %}</aside></div>{% endblock %}"},"startColumn":823,"startLine":1}}}],"message":{"text":"Template explicitly disables escaping; review the origin of the rendered value."},"properties":{},"ruleId":"sast.lab-jinja-autoescape-bypass"}],"tool":{"driver":{"name":"Semgrep OSS","rules":[{"defaultConfiguration":{"level":"warning"},"fullDescription":{"text":"Template explicitly disables escaping; review the origin of the rendered value."},"help":{"markdown":"Template explicitly disables escaping; review the origin of the rendered value.","text":"Template explicitly disables escaping; review the origin of the rendered value."},"id":"sast.lab-jinja-autoescape-bypass","name":"sast.lab-jinja-autoescape-bypass","properties":{"precision":"very-high","tags":["CWE-79: Cross-site Scripting","security"]},"shortDescription":{"text":"Semgrep Finding: sast.lab-jinja-autoescape-bypass"}},{"defaultConfiguration":{"level":"warning"},"fullDescription":{"text":"Request-controlled file path reaches send_file; validate resolved directory containment."},"help":{"markdown":"Request-controlled file path reaches send_file; validate resolved directory containment.","text":"Request-controlled file path reaches send_file; validate resolved directory containment."},"id":"sast.lab-request-to-send-file","name":"sast.lab-request-to-send-file","properties":{"precision":"very-high","tags":["CWE-22: Path Traversal","security"]},"shortDescription":{"text":"Semgrep Finding: sast.lab-request-to-send-file"}},{"defaultConfiguration":{"level":"warning"},"fullDescription":{"text":"Shell-enabled process execution; review whether untrusted input reaches the command."},"help":{"markdown":"Shell-enabled process execution; review whether untrusted input reaches the comm